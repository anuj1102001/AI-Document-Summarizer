# Copy to .env for local development. Never commit .env.

# SERVER-ONLY SECRET. Get a key at https://aistudio.google.com/apikey. Without it, upload, reading,
# search and citations still work; summaries, Q&A, extraction and comparison return a clear "AI not configured" error.
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
MAX_UPLOAD_MB=20
LLM_CALLS_PER_HOUR=60
